---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/layout/Nav.astro';
import Footer from '../../components/layout/Footer.astro';
import ProjectCharts from '../../components/projects/ProjectCharts';
import { isSample, projects } from '../../lib/data';
import type { Project } from '../../lib/schema';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project: p } = Astro.props as { project: Project };
---

<Base title={p.name} description={p.summary}>
  <Nav slot="nav" />

  <article class="pb-28 pt-8">
    <a href="/#projects" class="text-sm no-underline">
      ← All projects
    </a>
    <div class="mt-8 flex flex-wrap gap-3 font-mono text-xs text-muted">
      <span>{p.kind}</span>
      <span aria-hidden="true">·</span>
      <span>{p.year}</span>
      {isSample && <span class="rounded-full border border-line-strong px-2 py-0.5">SAMPLE DATA</span>}
    </div>
    <h1 class="mt-3 text-[40px] font-bold leading-[1.05] sm:text-[64px]">{p.name}</h1>
    <p class="mt-4 max-w-[680px] text-xl text-fg-2">{p.summary}</p>
    <ul class="m-0 mt-6 flex list-none flex-wrap gap-2 p-0">
      {p.stack.map((s) => (
        <li class="rounded-full border border-line-strong px-3 py-1.5 font-mono text-[13px] text-[#d3d7de]">{s}</li>
      ))}
    </ul>
    <a href={p.repoUrl} class="mt-6 inline-block no-underline" rel="noopener noreferrer" target="_blank">
      View repository →
    </a>

    <section aria-label="Results" class="mt-12">
      <ProjectCharts client:visible charts={p.charts} repoUrl={p.repoUrl} />
    </section>

    {p.readmeHtml && (
      <section aria-label="Case study" class="prose-case mt-16 max-w-[760px]">
        {/* readmeHtml sudah disanitasi saat build (src/lib/github.ts → renderReadme) */}
        <Fragment set:html={p.readmeHtml} />
      </section>
    )}
  </article>

  <Footer slot="footer" />
</Base>
