# ---- Build time (GitHub) ----
# Fine-grained PAT: Public repositories (read-only). Jangan pernah commit nilai aslinya.
GITHUB_TOKEN=
GITHUB_USERNAME=
# Topic yang menandai repo sebagai project portofolio
GITHUB_TOPIC=portfolio

# ---- Site ----
SITE_URL=https://example.com

# ---- Server (form kontak) ----
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Client (aman dipublikasikan) ----
PUBLIC_TURNSTILE_SITE_KEY=
